FLOWTRACK_DATABASE_URL=postgresql://flowtrack:flowtrack@localhost:5433/flowtrack
FLOWTRACK_DB_PORT=5433
FLOWTRACK_GITHUB_TOKEN=
FLOWTRACK_GITHUB_OWNER=
FLOWTRACK_GITHUB_REPO=
FLOWTRACK_JIRA_BASE_URL=
FLOWTRACK_JIRA_EMAIL=
FLOWTRACK_JIRA_TOKEN=
FLOWTRACK_JIRA_PROJECT_KEY=
FLOWTRACK_AUTO_SYNC=true

# Bearer token gating /api/* and /ws. Empty = no auth (assume localhost-only).
# Generate something random: `openssl rand -hex 32`.
FLOWTRACK_API_TOKEN=

# Sentry error monitoring for the daemon (optional)
# Empty DSN = Sentry disabled
FLOWTRACK_SENTRY_DSN=
FLOWTRACK_SENTRY_ENVIRONMENT=development
FLOWTRACK_SENTRY_RELEASE=
FLOWTRACK_SENTRY_TRACES_SAMPLE_RATE=0.0
FLOWTRACK_SENTRY_SEND_DEFAULT_PII=false

# Sentry as a discovery SOURCE (distinct from above — needs an Auth Token,
# not the DSN). Scopes: org:read, project:read, event:read, issue:read.
# Generate at https://sentry.io/settings/account/api/auth-tokens/
FLOWTRACK_SENTRY_TOKEN=
FLOWTRACK_SENTRY_ORG=
FLOWTRACK_SENTRY_PROJECT=
FLOWTRACK_SENTRY_DISCOVERY_QUERY=is:unresolved
FLOWTRACK_SENTRY_DISCOVERY_STATS_PERIOD=24h
FLOWTRACK_SENTRY_MIN_EVENT_COUNT=5
